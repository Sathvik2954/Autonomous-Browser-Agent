# Local LLM (Ollama) -- no API key needed, everything runs on your machine.
# Install Ollama, run `ollama serve`, and `ollama pull` the model below first.
# qwen2.5:3b is a lightweight (~2GB) default that runs fine without a GPU.
# For better reasoning on stronger hardware, try qwen2.5:7b or qwen2.5:14b.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Optional: comma-separated fallback models (still through Ollama, e.g. a
# Gemma model) tried in order if OLLAMA_MODEL fails to respond or keeps
# returning unusable output. Empty by default. Each one has to be pulled
# first -- verify the exact tag on Ollama's model library before pulling,
# e.g. `ollama pull gemma2:2b`.
OLLAMA_FALLBACK_MODELS=

# App settings
PORT=8000
HOST=127.0.0.1

# Browser Settings
BROWSER_HEADLESS=False # True to hide browser window, False to show it
BROWSER_TIMEOUT=30000 # Playwright action timeout in milliseconds
BROWSER_RECORD_VIDEO=True # True to record video of browser tasks
